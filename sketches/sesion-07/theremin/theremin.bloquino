  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nfloat distancia = 0;\n\nfloat distanciaCm(int disparo, int eco) {\n  digitalWrite(disparo, LOW);\n  delayMicroseconds(2);\n  digitalWrite(disparo, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(disparo, LOW);\n  unsigned long eco_us = pulseIn(eco, HIGH, 25000);\n  if (eco_us == 0) {\n    return 400;\n  }\n  return eco_us / 58.0;\n}\n\nvoid setup() {\n  pinMode(9, OUTPUT);\n  pinMode(10, INPUT);\n  pinMode(8, OUTPUT);\n}\n\nvoid loop() {\n  distancia = distanciaCm(9, 10);\n  if (distancia < 15) {\n    tone(8, 262, 30);\n    delay(30);\n  } else {\n    if (distancia < 30) {\n      tone(8, 330, 30);\n      delay(30);\n    } else {\n      if (distancia < 45) {\n        tone(8, 392, 30);\n        delay(30);\n      } else {\n        if (distancia < 60) {\n          tone(8, 523, 30);\n          delay(30);\n        } else {\n          noTone(8);\n          delay(30);\n        }\n      }\n    }\n  }\n}\n"
      },
