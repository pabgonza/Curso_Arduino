      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <DHT.h>\n\nDHT dht2(2, DHT11);\n\nvoid setup() {\n  Serial.begin(9600);\n  dht2.begin();\n}\n\nvoid loop() {\n  Serial.print(\"Temperatura: \");\n  Serial.println(dht2.readTemperature());\n  delay(1000);\n}\n"
