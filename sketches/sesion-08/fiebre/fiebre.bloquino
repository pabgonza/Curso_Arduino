    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <DHT.h>\n\nDHT dht2(2, DHT11);\n\nvoid setup() {\n  pinMode(8, OUTPUT);\n  Serial.begin(9600);\n  dht2.begin();\n}\n\nvoid loop() {\n  Serial.println(dht2.readTemperature());\n  if (dht2.readTemperature() > 30) {\n    tone(8, 880);\n    delay(1000);\n    noTone(8);\n  } else {\n    delay(1000);\n  }\n}\n"
      },
