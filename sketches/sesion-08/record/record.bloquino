  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <DHT.h>\n\nDHT dht2(2, DHT11);\nfloat record = 0;\n\nvoid setup() {\n  dht2.begin();\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  if (dht2.readTemperature() > record) {\n    record = dht2.readTemperature();\n  }\n  Serial.print(\"Ahora: \");\n  Serial.print(dht2.readTemperature());\n  Serial.print(\"   Record: \");\n  Serial.println(record);\n  delay(1000);\n}\n"
      },
