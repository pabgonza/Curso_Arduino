  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <DHT.h>\n\nDHT dht2(2, DHT11);\nfloat ya_avise = 0;\n\nvoid setup() {\n  pinMode(8, OUTPUT);\n  dht2.begin();\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  if (dht2.readTemperature() > 30) {\n    if (ya_avise == 0) {\n      Serial.println(\"¡Hace calor!\");\n      ya_avise = 1;\n    }\n    tone(8, 880);\n    delay(1000);\n    noTone(8);\n  } else {\n    ya_avise = 0;\n    delay(1000);\n  }\n}\n"
      },
