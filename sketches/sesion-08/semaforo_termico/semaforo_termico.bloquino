    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <DHT.h>\n\nDHT dht2(2, DHT11);\n\nvoid setup() {\n  pinMode(12, OUTPUT);\n  pinMode(11, OUTPUT);\n  pinMode(13, OUTPUT);\n  Serial.begin(9600);\n  dht2.begin();\n}\n\nvoid loop() {\n  Serial.println(dht2.readTemperature());\n  digitalWrite(12, LOW);\n  digitalWrite(11, LOW);\n  digitalWrite(13, LOW);\n  if (dht2.readTemperature() < 15) {\n    digitalWrite(12, HIGH);\n  } else {\n    if (dht2.readTemperature() < 25) {\n      digitalWrite(11, HIGH);\n    } else {\n      digitalWrite(13, HIGH);\n    }\n  }\n  delay(1000);\n}\n"
      },
