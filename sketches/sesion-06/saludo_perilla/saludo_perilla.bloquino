  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <Servo.h>\n\nfloat velocidad = 0;\nServo servo9;\n\nvoid setup() {\n  servo9.attach(9);\n}\n\nvoid loop() {\n  velocidad = (float)map(map(analogRead(A0), 0, 1023, 0, 100), 0, 100, 2, 40) / 1000;\n  for (int angulo = 60; angulo <= 120; angulo++) {\n    servo9.write(angulo);\n    delay(velocidad * 1000);\n  }\n  for (int angulo = 60; angulo <= 120; angulo++) {\n    servo9.write(180 - angulo);\n    delay(velocidad * 1000);\n  }\n}\n"
      },
