      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <Servo.h>\n\nfloat velocidad = 0;\nServo servo9;\n\nvoid setup() {\n  servo9.attach(9);\n  velocidad = 0.01;\n}\n\nvoid loop() {\n  for (int angulo = 60; angulo <= 120; angulo++) {\n    servo9.write(angulo);\n    delay(velocidad * 1000);\n  }\n  for (int angulo = 60; angulo <= 120; angulo++) {\n    servo9.write(180 - angulo);\n    delay(velocidad * 1000);\n  }\n}\n"
      },
