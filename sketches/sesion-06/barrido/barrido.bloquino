      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <Servo.h>\n\nServo servo9;\n\nvoid setup() {\n  servo9.attach(9);\n  servo9.write(0);\n  delay(500);\n}\n\nvoid loop() {\n  for (int angulo = 0; angulo <= 180; angulo++) {\n    servo9.write(angulo);\n    delay(15);\n  }\n  for (int angulo = 0; angulo <= 180; angulo++) {\n    servo9.write(180 - angulo);\n    delay(15);\n  }\n}\n"
      },
