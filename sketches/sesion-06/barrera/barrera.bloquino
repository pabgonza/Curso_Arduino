    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\n#include <Servo.h>\n\nServo servo9;\n\nvoid setup() {\n  pinMode(12, INPUT_PULLUP);\n  pinMode(13, OUTPUT);\n  servo9.attach(9);\n  servo9.write(90);\n  delay(500);\n}\n\nvoid loop() {\n  if (digitalRead(12) == LOW) {\n    servo9.write(0);\n    digitalWrite(13, HIGH);\n    delay(300);\n    digitalWrite(13, LOW);\n    delay(300);\n  } else {\n    servo9.write(90);\n    delay(300);\n    digitalWrite(13, LOW);\n  }\n}\n"
      },
