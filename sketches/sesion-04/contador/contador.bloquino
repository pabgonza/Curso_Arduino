    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nfloat ahora = 0;\nfloat antes = 0;\nfloat contador = 0;\n\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  ahora = digitalRead(2) == LOW;\n  if (ahora == 1 && antes == 0) {\n    contador += 1;\n    Serial.println(contador);\n  }\n  antes = ahora;\n}\n"
      },
