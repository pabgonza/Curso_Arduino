    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nfloat ahora = 0;\nfloat antes = 0;\nfloat encendida = 0;\n\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  pinMode(13, OUTPUT);\n}\n\nvoid loop() {\n  ahora = digitalRead(2) == LOW;\n  if (ahora == 1 && antes == 0) {\n    if (encendida == 0) {\n      encendida = 1;\n      digitalWrite(13, HIGH);\n    } else {\n      encendida = 0;\n      digitalWrite(13, LOW);\n    }\n    delay(50);\n  }\n  antes = ahora;\n}\n"
      },
