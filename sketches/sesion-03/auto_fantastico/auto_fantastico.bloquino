      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(13, OUTPUT);\n  pinMode(12, OUTPUT);\n  pinMode(11, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(13, HIGH);\n  delay(150);\n  digitalWrite(13, LOW);\n  digitalWrite(12, HIGH);\n  delay(150);\n  digitalWrite(12, LOW);\n  digitalWrite(11, HIGH);\n  delay(150);\n  digitalWrite(11, LOW);\n  digitalWrite(12, HIGH);\n  delay(150);\n  digitalWrite(12, LOW);\n}\n"
      },
