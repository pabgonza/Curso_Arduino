    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(13, OUTPUT);\n  pinMode(12, OUTPUT);\n  pinMode(11, OUTPUT);\n}\n\nvoid loop() {\n  // luz roja: 3 segundos\n  digitalWrite(13, HIGH);\n  delay(3000);\n  digitalWrite(13, LOW);\n  // luz verde: 3 segundos\n  digitalWrite(12, HIGH);\n  delay(3000);\n  digitalWrite(12, LOW);\n  // amarilla: 1 segundo\n  digitalWrite(11, HIGH);\n  delay(1000);\n  digitalWrite(11, LOW);\n}\n"
      },
