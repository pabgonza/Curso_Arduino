    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  pinMode(8, OUTPUT);\n  pinMode(3, INPUT_PULLUP);\n  pinMode(4, INPUT_PULLUP);\n}\n\nvoid loop() {\n  if (digitalRead(2) == LOW) {\n    tone(8, 262);\n    delay(200);\n    noTone(8);\n    tone(8, 330);\n    delay(200);\n    noTone(8);\n    tone(8, 392);\n    delay(400);\n    noTone(8);\n  }\n  if (digitalRead(3) == LOW) {\n    tone(8, 392);\n    delay(200);\n    noTone(8);\n    tone(8, 330);\n    delay(200);\n    noTone(8);\n    tone(8, 262);\n    delay(400);\n    noTone(8);\n  }\n  if (digitalRead(4) == LOW) {\n    tone(8, 440);\n    delay(150);\n    noTone(8);\n    tone(8, 659);\n    delay(150);\n    noTone(8);\n    tone(8, 440);\n    delay(150);\n    noTone(8);\n    tone(8, 659);\n    delay(150);\n    noTone(8);\n  }\n}\n"
      },
