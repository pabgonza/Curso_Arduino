      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  pinMode(8, OUTPUT);\n}\n\nvoid loop() {\n  if (digitalRead(2) == LOW) {\n    tone(8, 523);\n    delay(200);\n    noTone(8);\n    tone(8, 392);\n    delay(400);\n    noTone(8);\n  }\n}\n"
      },
