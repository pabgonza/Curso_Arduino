    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid color(float r, float g, float b) {\n  analogWrite(6, 255 - r);\n  analogWrite(5, 255 - g);\n  analogWrite(3, 255 - b);\n}\n\nvoid setup() {\n  pinMode(6, OUTPUT);\n  pinMode(5, OUTPUT);\n  pinMode(3, OUTPUT);\n}\n\nvoid loop() {\n  // naranjo\n  color(255, 120, 0);\n  delay(1000);\n  // morado\n  color(150, 0, 255);\n  delay(1000);\n  // celeste\n  color(0, 200, 255);\n  delay(1000);\n  // rosado\n  color(255, 60, 120);\n  delay(1000);\n  // amarillo (¡rojo + verde!)\n  color(255, 255, 0);\n  delay(1000);\n  // blanco\n  color(255, 255, 255);\n  delay(1000);\n}\n"
      },
