  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(3, OUTPUT);\n  pinMode(5, OUTPUT);\n  pinMode(6, OUTPUT);\n}\n\nvoid loop() {\n  // naranjo\n  analogWrite(3, 255);\n  analogWrite(5, 120);\n  analogWrite(6, 0);\n  delay(1000);\n  // morado\n  analogWrite(3, 150);\n  analogWrite(5, 0);\n  analogWrite(6, 255);\n  delay(1000);\n  // celeste\n  analogWrite(3, 0);\n  analogWrite(5, 200);\n  analogWrite(6, 255);\n  delay(1000);\n  // rosado\n  analogWrite(3, 255);\n  analogWrite(5, 60);\n  analogWrite(6, 120);\n  delay(1000);\n  // amarillo (¡rojo + verde!)\n  analogWrite(3, 255);\n  analogWrite(5, 255);\n  analogWrite(6, 0);\n  delay(1000);\n  // blanco\n  analogWrite(3, 255);\n  analogWrite(5, 255);\n  analogWrite(6, 255);\n  delay(1000);\n}\n"
      },
