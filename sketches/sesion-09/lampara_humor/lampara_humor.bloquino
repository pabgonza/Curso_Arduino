  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nfloat distancia = 0;\nfloat pos = 0;\nfloat tramo = 0;\n\nfloat distanciaCm(int disparo, int eco) {\n  digitalWrite(disparo, LOW);\n  delayMicroseconds(2);\n  digitalWrite(disparo, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(disparo, LOW);\n  unsigned long eco_us = pulseIn(eco, HIGH, 25000);\n  if (eco_us == 0) {\n    return 400;\n  }\n  return eco_us / 58.0;\n}\n\nvoid setup() {\n  pinMode(9, OUTPUT);\n  pinMode(10, INPUT);\n  pinMode(3, OUTPUT);\n  pinMode(5, OUTPUT);\n  pinMode(6, OUTPUT);\n}\n\nvoid loop() {\n  distancia = constrain(distanciaCm(9, 10), 5, 50);\n  pos = map(distancia, 5, 50, 0, 255);\n  if (pos < 85) {\n    // rojo → verde\n    analogWrite(3, 255 - pos * 3);\n    analogWrite(5, pos * 3);\n    analogWrite(6, 0);\n  } else {\n    if (pos < 170) {\n      // verde → azul\n      tramo = pos - 85;\n      analogWrite(3, 0);\n      analogWrite(5, 255 - tramo * 3);\n      analogWrite(6, tramo * 3);\n    } else {\n      // azul → rojo\n      tramo = pos - 170;\n      analogWrite(3, tramo * 3);\n      analogWrite(5, 0);\n      analogWrite(6, 255 - tramo * 3);\n    }\n  }\n  delay(30);\n}\n"
      },
