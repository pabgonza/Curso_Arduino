    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid color(float r, float g, float b) {\n  analogWrite(6, 255 - r);\n  analogWrite(5, 255 - g);\n  analogWrite(3, 255 - b);\n}\n\nvoid setup() {\n  pinMode(6, OUTPUT);\n  pinMode(5, OUTPUT);\n  pinMode(3, OUTPUT);\n}\n\nvoid loop() {\n  // inhala: sube el brillo\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    color(brillo, 0, 0);\n    delay(5);\n  }\n  // exhala: lo baja\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    color(255 - brillo, 0, 0);\n    delay(5);\n  }\n}\n"
      },
