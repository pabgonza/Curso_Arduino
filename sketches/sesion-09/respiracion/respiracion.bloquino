  "fileGroups": {
    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(6, OUTPUT);\n}\n\nvoid loop() {\n  // inhala: sube el brillo\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    analogWrite(6, brillo);\n    delay(5);\n  }\n  // exhala: lo baja\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    analogWrite(6, 255 - brillo);\n    delay(5);\n  }\n}\n"
      },
