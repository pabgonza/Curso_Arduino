    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid setup() {\n  pinMode(5, OUTPUT);\n  pinMode(3, OUTPUT);\n  pinMode(6, OUTPUT);\n  analogWrite(5, 0);\n}\n\nvoid loop() {\n  // inhala: morado (150, 0, 255) de apagado a todo\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    analogWrite(3, map(brillo, 0, 255, 0, 150));\n    analogWrite(6, brillo);\n    delay(5);\n  }\n  // exhala\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    analogWrite(3, map(255 - brillo, 0, 255, 0, 150));\n    analogWrite(6, 255 - brillo);\n    delay(5);\n  }\n}\n"
      },
