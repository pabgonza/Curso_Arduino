    "group-arduino-uno": [
      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid color(float r, float g, float b) {\n  analogWrite(6, r);\n  analogWrite(5, g);\n  analogWrite(3, b);\n}\n\nvoid setup() {\n  pinMode(6, OUTPUT);\n  pinMode(5, OUTPUT);\n  pinMode(3, OUTPUT);\n}\n\nvoid loop() {\n  // inhala: morado (150, 0, 255) de apagado a todo\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    color(map(brillo, 0, 255, 0, 150), 0, brillo);\n    delay(5);\n  }\n  // exhala\n  for (int brillo = 0; brillo <= 255; brillo++) {\n    color(map(255 - brillo, 0, 255, 0, 150), 0, 255 - brillo);\n    delay(5);\n  }\n}\n"
      },
