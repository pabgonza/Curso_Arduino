      {
        "name": "sketch.ino",
        "content": "// Generado desde bloques\nvoid color(float r, float g, float b) {\n  analogWrite(6, 255 - r);\n  analogWrite(5, 255 - g);\n  analogWrite(3, 255 - b);\n}\n\nvoid setup() {\n  pinMode(6, OUTPUT);\n  pinMode(5, OUTPUT);\n  pinMode(3, OUTPUT);\n}\n\nvoid loop() {\n  color(random(0, 256), random(0, 256), random(0, 256));\n  delay(500);\n}\n"
      },
